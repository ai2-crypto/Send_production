# Đường dẫn file SQLite. Bỏ trống để dùng data/gui_san_luong.db
GUI_SAN_LUONG_DB=
# File SQLite lưu kết quả đọc Excel để tải lại nhanh; xóa được bất cứ lúc nào.
# Bỏ trống để dùng data/import_cache.db
GUI_SAN_LUONG_IMPORT_CACHE=
# Để trang tự làm mới access token Zalo. Access token và refresh token KHÔNG để ở đây: dán
# một lần ở tab "Tin nhắn Zalo (thử)", trang lưu mã hóa vào DB và tự làm mới, vì mỗi lần làm
# mới Zalo cấp refresh token mới và vô hiệu cái cũ. Không commit file .env.
# App ID và Secret key: trang quản lý ứng dụng trên Zalo for Developers.
ZALO_APP_ID=
ZALO_SECRET_KEY=
# Khóa mã hóa token lưu trong DB. Tạo bằng:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Đổi hoặc mất khóa này thì phải dán lại token.
TOKEN_ENCRYPTION_KEY=
# Cách cũ, chỉ dùng khi chưa dán token ở trang: OA access token lấy tay từ API Explorer,
# hết hạn sau khoảng 25 giờ và không tự làm mới.
ZALO_OA_ACCESS_TOKEN=
# Chỉ dùng khi chạy bằng Docker (compose.yaml): UID/GID tài khoản chạy container, phải ghi
# được thư mục data. Trên Synology đặt bằng kết quả của `id <tên-tài-khoản>`. Bỏ trống = 1000.
PUID=
PGID=
